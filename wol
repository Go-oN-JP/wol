#!/usr/bin/env bash

set -u

CONFIG_FILE="/etc/wol/hosts"

# Check dependencies.
if ! command -v wakeonlan >/dev/null 2>&1; then
    echo "Error: wakeonlan is not installed." >&2
    exit 1
fi

# Check configuration file.
if [[ ! -r "$CONFIG_FILE" ]]; then
    echo "Error: Cannot read $CONFIG_FILE" >&2
    exit 1
fi

# Load and validate configuration.
HOSTS=()
LINE_NUMBER=0
ERROR_FOUND=0

while IFS= read -r LINE || [[ -n "$LINE" ]]; do
    ((LINE_NUMBER += 1))

    # Ignore blank lines and comments.
    [[ "$LINE" =~ ^[[:space:]]*$ ]] && continue
    [[ "$LINE" =~ ^[[:space:]]*# ]] && continue

    read -r IP_ADDR MAC_ADDR HOSTNAME EXTRA <<< "$LINE"

    if [[ -z "${IP_ADDR:-}" || -z "${MAC_ADDR:-}" || -n "${EXTRA:-}" ]]; then
        echo "Error: Invalid configuration at line $LINE_NUMBER." >&2
        echo "Expected: IP_ADDRESS MAC_ADDRESS [HOSTNAME]" >&2
        ERROR_FOUND=1
        continue
    fi

    if [[ ! "$IP_ADDR" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        echo "Error: Invalid IPv4 address at line $LINE_NUMBER: $IP_ADDR" >&2
        ERROR_FOUND=1
        continue
    fi

    IFS='.' read -r -a OCTETS <<< "$IP_ADDR"
    VALID_IP=1
    for OCTET in "${OCTETS[@]}"; do
        if ((10#$OCTET > 255)); then
            VALID_IP=0
            break
        fi
    done

    if ((VALID_IP == 0)); then
        echo "Error: Invalid IPv4 address at line $LINE_NUMBER: $IP_ADDR" >&2
        ERROR_FOUND=1
        continue
    fi

    if [[ ! "$MAC_ADDR" =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ ]]; then
        echo "Error: Invalid MAC address at line $LINE_NUMBER: $MAC_ADDR" >&2
        ERROR_FOUND=1
        continue
    fi

    HOSTS+=("$IP_ADDR $MAC_ADDR ${HOSTNAME:-}")
done < "$CONFIG_FILE"

if ((ERROR_FOUND)); then
    echo "Error: Fix the configuration file before using wol." >&2
    exit 1
fi

# Display configured hosts.
list_hosts() {
    if ((${#HOSTS[@]} == 0)); then
        echo "No hosts configured."
        return
    fi

    printf " No  %-20s %-15s %s\n" "HOSTNAME" "IP ADDRESS" "MAC ADDRESS"

    local i ip mac hostname
    for i in "${!HOSTS[@]}"; do
        read -r ip mac hostname <<< "${HOSTS[$i]}"
        printf " %02d  %-20s %-15s %s\n" \
            "$((i + 1))" "${hostname:-}" "$ip" "$mac"
    done
}

# Send a magic packet to the selected host.
send_wol() {
    local info="$1"
    local ip mac hostname

    read -r ip mac hostname <<< "$info"

    if [[ -n "$hostname" ]]; then
        echo "Sending Wake-on-LAN packet to $hostname ($ip, $mac)..."
    else
        echo "Sending Wake-on-LAN packet to $ip ($mac)..."
    fi

    wakeonlan "$mac"
}

# No argument: list configured hosts.
if (($# == 0)); then
    list_hosts
    exit 0
fi

if (($# > 1)); then
    echo "Usage: wol [hostname | index | IP]" >&2
    exit 1
fi

INPUT="$1"

# Numeric argument: select by list number.
if [[ "$INPUT" =~ ^[0-9]+$ ]]; then
    # Remove leading zeros safely before arithmetic evaluation.
    INDEX="$INPUT"
    while [[ ${#INDEX} -gt 1 && "$INDEX" == 0* ]]; do
        INDEX="${INDEX#0}"
    done

    if ((INDEX < 1 || INDEX > ${#HOSTS[@]})); then
        echo "Error: Host number out of range: $INPUT" >&2
        exit 1
    fi

    send_wol "${HOSTS[$((INDEX - 1))]}"
    exit $?
fi

# Search by IP address or hostname (case-insensitive).
MATCHES=()

for INFO in "${HOSTS[@]}"; do
    read -r IP_ADDR MAC_ADDR TARGET_HOST <<< "$INFO"

    if [[ "$IP_ADDR" == "$INPUT" ]] ||
       [[ -n "$TARGET_HOST" && "${TARGET_HOST,,}" == "${INPUT,,}" ]]; then
        MATCHES+=("$INFO")
    fi
done

if ((${#MATCHES[@]} == 0)); then
    echo "Error: Host not found: $INPUT" >&2
    exit 1
fi

if ((${#MATCHES[@]} > 1)); then
    echo "Error: Multiple hosts matched '$INPUT':" >&2
    for INFO in "${MATCHES[@]}"; do
        read -r IP_ADDR MAC_ADDR TARGET_HOST <<< "$INFO"
        printf "  %-20s %s\n" "${TARGET_HOST:-}" "$IP_ADDR" >&2
    done
    exit 1
fi

send_wol "${MATCHES[0]}"

